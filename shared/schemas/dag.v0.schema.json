{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gonullu-hesaplama/schemas/dag.v0.json",
  "title": "DAG iş tanımı v0",
  "type": "object",
  "required": ["version", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 0 },
    "jobId": { "type": "string", "maxLength": 128 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["id", "module", "input"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "module": { "type": "string", "enum": ["sha_chain", "matmul", "debug_panic"] },
          "moduleHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "input": { "type": "object" },
          "cost": { "type": "number", "minimum": 0 },
          "deps": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
