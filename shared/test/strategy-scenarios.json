{
  "_comment": "Ortak altın senaryolar (9. hafta, 9.2). sim/vcsim/strategies (pytest) ve coordinator/src/strategies.ts (node --test) aynı kararları vermek zorundadır. Kopyalar: state, output, alone_ok. Karar türleri snake_case (need_more); TypeScript testi kendi adlarına çevirir. Yalnızca simülatörde bulunan stratejilerin (boinc_adaptive) senaryoları koordinatör testinde atlanır.",
  "on_result": [
    { "name": "fixed2: iki eşleşen kabul", "verifier": "fixed2",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_OK", "x"]], "expect": { "kind": "accept", "output": "x" } },
    { "name": "fixed2: biri çalışıyor, bekle", "verifier": "fixed2",
      "replicas": [["RETURNED_OK", "x"], ["ASSIGNED", null]], "expect": { "kind": "wait" } },
    { "name": "fixed2: uyuşmazlık, bir kopya daha", "verifier": "fixed2",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_OK", "y"]], "expect": { "kind": "need_more", "count": 1 } },
    { "name": "fixed2: üçüncü kopya y'yi doğrular", "verifier": "fixed2",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_OK", "y"], ["RETURNED_OK", "y"]], "expect": { "kind": "accept", "output": "y" } },
    { "name": "fixed2: kaybolan kopya sayılmaz", "verifier": "fixed2",
      "replicas": [["RETURNED_OK", "x"], ["LOST", null]], "expect": { "kind": "need_more", "count": 1 } },
    { "name": "fixed2: WASM hatası sayılmaz", "verifier": "fixed2",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_ERROR", "RuntimeError"]], "expect": { "kind": "need_more", "count": 1 } },
    { "name": "fixed3: iki eşleşme var ama üçüncü çalışıyor, bekle", "verifier": "fixed3",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_OK", "x"], ["ASSIGNED", null]], "expect": { "kind": "wait" } },
    { "name": "fixed3: 2'ye 1 çoğunluk", "verifier": "fixed3",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_OK", "y"], ["RETURNED_OK", "x"]], "expect": { "kind": "accept", "output": "x" } },
    { "name": "fixed3: üçü farklı, bir kopya daha", "verifier": "fixed3",
      "replicas": [["RETURNED_OK", "x"], ["RETURNED_OK", "y"], ["RETURNED_OK", "z"]], "expect": { "kind": "need_more", "count": 1 } },
    { "name": "adaptive: güvenilir tek kopya kabul", "verifier": "adaptive",
      "replicas": [["RETURNED_OK", "x", true]], "expect": { "kind": "accept", "output": "x" } },
    { "name": "adaptive: güvenilmez tek sonuç, ikinci kopya kuyrukta, bekle", "verifier": "adaptive",
      "replicas": [["RETURNED_OK", "x", false], ["QUEUED", null]], "expect": { "kind": "wait" } },
    { "name": "adaptive: güvenilmeze atanmış görevde güvenilir kopya tek başına yetmez", "verifier": "adaptive",
      "replicas": [["ASSIGNED", null, false], ["RETURNED_OK", "x", true]], "expect": { "kind": "wait" } },
    { "name": "adaptive: iki eşleşen kabul", "verifier": "adaptive",
      "replicas": [["RETURNED_OK", "x", false], ["RETURNED_OK", "x", true]], "expect": { "kind": "accept", "output": "x" } },
    { "name": "adaptive: uyuşmazlık, bir kopya daha", "verifier": "adaptive",
      "replicas": [["RETURNED_OK", "x", false], ["RETURNED_OK", "y", false]], "expect": { "kind": "need_more", "count": 1 } },
    { "name": "adaptive: güvenilir kopya kayboldu, yerine güvenilmez geldi", "verifier": "adaptive",
      "replicas": [["LOST", null, true], ["RETURNED_OK", "x", false], ["QUEUED", null]], "expect": { "kind": "wait" } },
    { "name": "boinc_adaptive: tek başına yeterli kopya kabul", "verifier": "boinc_adaptive",
      "replicas": [["RETURNED_OK", "x", true]], "expect": { "kind": "accept", "output": "x" } },
    { "name": "accept_first: ilk sonuç kabul", "verifier": "accept_first",
      "replicas": [["RETURNED_OK", "x"]], "expect": { "kind": "accept", "output": "x" } },
    { "name": "accept_first: hata döndü, yeni kopya", "verifier": "accept_first",
      "replicas": [["RETURNED_ERROR", "RuntimeError"]], "expect": { "kind": "need_more", "count": 1 } }
  ],
  "on_assign": [
    { "name": "adaptive: güvenilir worker, tek kopya", "verifier": "adaptive",
      "replicas": [["ASSIGNED", null]], "worker": { "trusted": true }, "u": 0.5, "expect": { "extra": 0, "alone_ok": true } },
    { "name": "adaptive: güvenilmez worker, ikinci kopya açılır", "verifier": "adaptive",
      "replicas": [["ASSIGNED", null]], "worker": { "trusted": false }, "u": 0.5, "expect": { "extra": 1, "alone_ok": false } },
    { "name": "adaptive: ikinci kopya zaten var", "verifier": "adaptive",
      "replicas": [["ASSIGNED", null], ["ASSIGNED", null]], "worker": { "trusted": false }, "u": 0.5, "expect": { "extra": 0, "alone_ok": false } },
    { "name": "fixed2: atamada ek kopya yok", "verifier": "fixed2",
      "replicas": [["ASSIGNED", null], ["QUEUED", null]], "worker": { "trusted": true }, "u": 0.5, "expect": { "extra": 0, "alone_ok": false } },
    { "name": "accept_first: tek başına yeterli", "verifier": "accept_first",
      "replicas": [["ASSIGNED", null]], "worker": { "trusted": false }, "u": 0.5, "expect": { "extra": 0, "alone_ok": true } },
    { "name": "boinc_adaptive: N < 10 her zaman replike", "verifier": "boinc_adaptive",
      "replicas": [["ASSIGNED", null]], "worker": { "consecutive_valid": 9 }, "u": 0.99, "expect": { "extra": 1, "alone_ok": false } },
    { "name": "boinc_adaptive: N = 40, u < 1/40 replike", "verifier": "boinc_adaptive",
      "replicas": [["ASSIGNED", null]], "worker": { "consecutive_valid": 40 }, "u": 0.02, "expect": { "extra": 1, "alone_ok": false } },
    { "name": "boinc_adaptive: N = 40, u ≥ 1/40 tek kopya", "verifier": "boinc_adaptive",
      "replicas": [["ASSIGNED", null]], "worker": { "consecutive_valid": 40 }, "u": 0.03, "expect": { "extra": 0, "alone_ok": true } }
  ],
  "pick": [
    { "name": "fifo: listenin başı", "scheduler": "fifo",
      "idle": [["a", 1.0, 0, 0], ["b", 9.0, 0, 0]], "expect": "a" },
    { "name": "fifo: boş liste", "scheduler": "fifo", "idle": [], "expect": null },
    { "name": "fastest: en yüksek hız", "scheduler": "fastest",
      "idle": [["a", 1.0, 0, 0], ["b", 3.0, 0, 0], ["c", 2.0, 0, 0]], "expect": "b" },
    { "name": "fastest: ölçülmemiş worker eşitlikte önce denenir", "scheduler": "fastest",
      "idle": [["a", 1.0, 0, 0], ["b", 3.0, 0, 0], ["new", null, 0, 0]], "expect": "new" },
    { "name": "fastest: hiçbiri ölçülmemiş, listenin başı", "scheduler": "fastest",
      "idle": [["x", null, 0, 0], ["y", null, 0, 0]], "expect": "x" },
    { "name": "reputation: yavaş ama güvenilir hızlı ama güvenilmezi geçer", "scheduler": "reputation",
      "idle": [["fast", 3.0, 0, 5], ["slow", 1.0, 50, 0]], "expect": "slow" },
    { "name": "reputation: itibar eşitse hız belirler", "scheduler": "reputation",
      "idle": [["a", 1.0, 10, 0], ["b", 2.0, 10, 0]], "expect": "b" }
  ],
  "replication_events": [
    { "name": "tek kopya olay üretmez", "accepted": "x", "returned": [["w1", "x"]], "expect": [] },
    { "name": "iki eşleşen", "accepted": "x", "returned": [["w1", "x"], ["w2", "x"]], "expect": [["w1", "match"], ["w2", "match"]] },
    { "name": "aykırı kopya mismatch alır", "accepted": "x", "returned": [["w1", "x"], ["w2", "y"], ["w3", "x"]],
      "expect": [["w1", "match"], ["w2", "mismatch"], ["w3", "match"]] },
    { "name": "colluder'lar yanlış sonuçta eşleşince ikisi de match", "accepted": "bad",
      "returned": [["c1", "bad"], ["c2", "bad"], ["h", "good"]], "expect": [["c1", "match"], ["c2", "match"], ["h", "mismatch"]] }
  ]
}
