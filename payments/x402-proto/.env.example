# npm run keys -w payments/x402-proto bu dosyanın doldurulmuş hâlini .env olarak üretir.
# YALNIZCA Devnet için atılabilir anahtarlar kullanın; .env asla commit edilmez.
BUYER_PRIVATE_KEY=
BUYER_ADDRESS=
PLATFORM_ADDRESS=
PLATFORM_PRIVATE_KEY=
FACILITATOR_URL=https://x402.org/facilitator

# Yerel facilitator (herkese açık facilitator'ın RPC sınırı için): npm run keys -w payments/x402-proto -- --facilitator
# Sonra FACILITATOR_URL=http://127.0.0.1:4022 yapın. SOLANA_RPC_URL isteğe bağlıdır (kendi Devnet RPC adresiniz).
FACILITATOR_PRIVATE_KEY=
FACILITATOR_ADDRESS=
SOLANA_RPC_URL=
